# 本地开发环境变量
# 复制此文件为 .env.local 并填入实际值

# 项目站点路径前缀（用户站点留空）
# 例如部署到 username.github.io/personal-website 则设为 /personal-website
NEXT_PUBLIC_BASE_PATH=/personal-website

# 生产环境完整 URL
NEXT_PUBLIC_SITE_URL=https://lazycatzzzzz.github.io/personal-website

# DeepSeek API 密钥（⚠️ 警告：该值会暴露在客户端 JS 中）
# 本地开发从 .env.local 读取，CI/CD 从 GitHub Secrets 注入
NEXT_PUBLIC_DEEPSEEK_API_KEY=
